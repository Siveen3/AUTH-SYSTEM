<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <main class="page-wrapper">
        <section class="auth-container">
            <div class="auth-banner">
                <div class="brand-header">
                    <div class="brand-logo-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 12h16M12 4v16" stroke="white"/></svg>
                    </div>
                    <div class="brand-name">AuthSystem</div>
                </div>

                <div class="banner-hero-content">
                    <h2 class="banner-title">Welcome</h2>
                    <p class="banner-subtitle">Your secure dashboard.</p>
                    <div class="banner-illustration-wrapper">
                        <img class="banner-illustration" src="/assets/auth_hero.jpg" alt="Dashboard" />
                    </div>
                </div>
            </div>

            <div class="auth-form-card">
                <div class="form-header">
                    <div class="form-title">Dashboard</div>
                    <div class="form-subtitle">You are signed in and your session is protected by JWT.</div>
                </div>

                <div class="dashboard-content">
                    <p>Your user id is: <strong><%= userId %></strong></p>
                    <p>Secure pages are protected with token and password version checks.</p>
                    <a class="btn-primary" href="/logout">Sign out</a>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
