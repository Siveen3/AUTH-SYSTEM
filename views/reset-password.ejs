<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <main class="page-wrapper">
        <section class="auth-container">
            <div class="auth-banner">
                <div class="brand-header">
                    <div class="brand-logo-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 12h16M12 4v16" stroke="white"/></svg>
                    </div>
                    <div class="brand-name">AuthSystem</div>
                </div>

                <div class="banner-hero-content">
                    <h2 class="banner-title">Reset your password</h2>
                    <p class="banner-subtitle">Choose a new secure password for your account.</p>
                    <div class="banner-illustration-wrapper">
                        <img class="banner-illustration" src="/assets/auth_hero.jpg" alt="Reset" />
                    </div>
                </div>

                <div class="banner-features">
                    <div class="feature-pill">Short lived tokens</div>
                    <div class="feature-pill">Secure updates</div>
                    <div class="feature-pill">One-click flow</div>
                </div>

                <div class="banner-footer">If the token is missing or expired, request a new reset link.</div>
            </div>

            <div class="auth-form-card">
                <div class="form-header">
                    <div class="form-title">Reset Password</div>
                    <div class="form-subtitle">Enter a new password for your account.</div>
                </div>

                <form id="resetForm" class="auth-form">
                    <input type="hidden" id="resetToken" value="<%= token %>">

                    <div class="form-group">
                        <label class="form-label" for="resetPassword">New Password</label>
                        <div class="input-wrapper">
                            <span class="input-icon-left">*</span>
                            <input id="resetPassword" class="form-control" name="resetPassword" type="password" required>
                            <button type="button" class="btn-toggle-password" data-target="resetPassword">
                                <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/></svg>
                                <svg class="eye-off-icon" style="display:none" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a21.67 21.67 0 0 1 5.14-6.46"/></svg>
                            </button>
                        </div>
                        <div id="resetPasswordFeedback" class="feedback-message"></div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="resetConfirmPassword">Confirm Password</label>
                        <div class="input-wrapper">
                            <span class="input-icon-left">*</span>
                            <input id="resetConfirmPassword" class="form-control" name="resetConfirmPassword" type="password" required>
                            <button type="button" class="btn-toggle-password" data-target="resetConfirmPassword">
                                <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/></svg>
                                <svg class="eye-off-icon" style="display:none" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a21.67 21.67 0 0 1 5.14-6.46"/></svg>
                            </button>
                        </div>
                        <div id="resetConfirmPasswordFeedback" class="feedback-message"></div>
                    </div>

                    <button class="btn-primary" type="submit"><span class="btn-text">Reset Password</span><span class="btn-spinner"></span></button>
                </form>
            </div>
        </section>
    </main>
    <script src="/js/script.js"></script>
</body>
</html>
