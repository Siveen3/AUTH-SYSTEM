<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <main class="page-wrapper">
        <section class="auth-container">
            <div class="auth-banner">
                <div class="brand-header">
                    <div class="brand-logo-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 12h16M12 4v16" stroke="white"/></svg>
                    </div>
                    <div class="brand-name">AuthSystem</div>
                </div>

                <div class="banner-hero-content">
                    <h2 class="banner-title">Create a secure account</h2>
                    <p class="banner-subtitle">Strong passwords, easy testing, and painless signup UX.</p>
                    <div class="banner-illustration-wrapper">
                        <img class="banner-illustration" src="/assets/auth_hero.jpg" alt="Create account illustration" />
                    </div>
                </div>

                <div class="banner-features">
                    <div class="feature-pill">Password strength meter</div>
                    <div class="feature-pill">Terms + Privacy</div>
                    <div class="feature-pill">Quick local testing</div>
                </div>

                <div class="banner-footer">Sign up and immediately test with in-memory DB.</div>
            </div>

            <div class="auth-form-card">
                <div class="top-actions-bar">
                    <button id="themeToggleBtn" class="theme-toggle-btn" title="Toggle theme">
                        <svg class="light-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="4"/></svg>
                        <svg class="dark-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
                    </button>
                </div>

                <div class="form-header">
                    <div class="form-title">Create account</div>
                    <div class="form-subtitle">Register a new account to unlock secure access.</div>
                </div>

                <form id="signupForm" class="auth-form">
                    <div class="form-group">
                        <label class="form-label" for="signupName">Full name</label>
                        <div class="input-wrapper">
                            <span class="input-icon-left">👤</span>
                            <input id="signupName" class="form-control" name="name" type="text" required>
                        </div>
                        <div id="signupNameFeedback" class="feedback-message"></div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="signupEmail">Email address</label>
                        <div class="input-wrapper">
                            <span class="input-icon-left">@</span>
                            <input id="signupEmail" class="form-control" name="email" type="email" required>
                        </div>
                        <div id="signupEmailFeedback" class="feedback-message"></div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="signupPassword">Password</label>
                        <div class="input-wrapper">
                            <span class="input-icon-left">*</span>
                            <input id="signupPassword" class="form-control" name="password" type="password" required>
                            <button type="button" class="btn-toggle-password" data-target="signupPassword">
                                <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/></svg>
                                <svg class="eye-off-icon" style="display:none" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a21.67 21.67 0 0 1 5.14-6.46"/></svg>
                            </button>
                        </div>
                        <div id="signupPasswordFeedback" class="feedback-message"></div>

                        <div class="password-strength-container">
                            <div class="strength-meter-bar">
                                <div class="strength-segment"></div>
                                <div class="strength-segment"></div>
                                <div class="strength-segment"></div>
                                <div class="strength-segment"></div>
                            </div>
                            <div class="strength-status-text">
                                <div id="strengthLabel"></div>
                            </div>
                            <ul class="strength-checklist">
                                <li id="checkLength">Minimum 8 characters</li>
                                <li id="checkUpper">Uppercase letter</li>
                                <li id="checkNumber">Contains a number</li>
                                <li id="checkSpecial">Contains a special character</li>
                            </ul>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="signupConfirmPassword">Confirm password</label>
                        <div class="input-wrapper">
                            <span class="input-icon-left">*</span>
                            <input id="signupConfirmPassword" class="form-control" name="confirmPassword" type="password" required>
                            <button type="button" class="btn-toggle-password" data-target="signupConfirmPassword">
                                <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/></svg>
                                <svg class="eye-off-icon" style="display:none" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a21.67 21.67 0 0 1 5.14-6.46"/></svg>
                            </button>
                        </div>
                        <div id="signupConfirmPasswordFeedback" class="feedback-message"></div>
                    </div>

                    <div class="form-row">
                        <label class="custom-checkbox-label">
                            <input id="termsCheckbox" class="custom-checkbox-input" type="checkbox" required>
                            <span class="checkbox-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"/></svg></span>
                            <span>I agree to the <a href="#">terms and conditions</a>.</span>
                        </label>
                    </div>

                    <button class="btn-primary" type="submit"><span class="btn-text">Create account</span><span class="btn-spinner"></span></button>
                </form>

                <footer class="auth-footer" style="margin-top:1.25rem">
                    <p>Already have an account? <a href="/login">Sign in</a></p>
                </footer>
            </div>
        </section>
    </main>
    <script src="/js/script.js"></script>
</body>
</html>
