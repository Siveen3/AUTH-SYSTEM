NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/auth-system

# Access tokens are issued by the login endpoint and verified by AS-12.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_EXPIRES_IN=15m

# Reset tokens must use a different secret from access tokens.
JWT_RESET_SECRET=replace-with-a-long-random-reset-secret
JWT_RESET_EXPIRES_IN=15m
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# When set to true the app will use an in-memory JSON store instead of MongoDB.
# Useful for quick local runs or demos. Default: false
USE_IN_MEMORY_DB=false

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=AetherFlow <no-reply@example.com>

SUPABASE_PROJECT_URL=https://supabase.com/dashboard/project/wkxwxwznogfyhkucymzn/settings/api-keys/legacy
