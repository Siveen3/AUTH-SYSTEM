NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/auth-system

# Access tokens are issued by the login endpoint and verified by the JWT middleware.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_EXPIRES_IN=1h

# When set to true the app will use an in-memory JSON store instead of MongoDB.
# Useful for quick local runs or demos. Default: false
USE_IN_MEMORY_DB=false

# Redis connection URL (used for OTP storage during registration and password reset).
# Default: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# SMTP configuration (used to send OTP emails).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=AUTH-SYSTEM <no-reply@example.com>

# Set to true to suppress OTP/reset-link console output in CI environments.
# SUPPRESS_RESET_LINK_CONSOLE=true
